# Public client configuration
VITE_ENVIRONMENT=development
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only runtime configuration
NODE_ENV=development
GCP_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-pro
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_ID_TOKEN=
AUTH_BOOTSTRAP_SESSION_COOKIE=
AUTH_BOOTSTRAP_COMPANY_ID=demo-company
# Prefer AUTH_BOOTSTRAP_SESSION_COOKIE for deployment bootstrap.
# Keep AUTH_BOOTSTRAP_ID_TOKEN empty in persistent environments.

# Cloud Run and app configuration
APP_BASE_URL=http://localhost:5173
SYSTEM_PROMPT_VERSION=2026-04-06
DEFAULT_STYLE_STRENGTH=medium
DEFAULT_LANGUAGE=en

# Firestore storage thresholds
RESUME_INLINE_MAX_BYTES=102400
JOB_DESCRIPTION_INLINE_MAX_BYTES=51200
PROMPT_TEMPLATE_MAX_BYTES=10240

# Background job configuration
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE_BULK_GENERATION=
BULK_GENERATION_MAX_CONCURRENCY=5

# Logging and observability
LOG_LEVEL=info